generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. PRODUK / MENU
// -------------------------------------------------------------
model Product {
  id          String      @id @default(uuid())
  name        String
  price       Int
  description String?     @db.Text
  imageUrl    String?     @map("image_url")
  isActive    Boolean     @default(true) @map("is_active")
  category    String      @default("Makanan")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  orderItems  OrderItem[]

  @@map("products")
}

// -------------------------------------------------------------
// 2. REFERENSI (DIVISI & LOKASI)
// -------------------------------------------------------------
model Division {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("divisions")
}

model Location {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("locations")
}

// -------------------------------------------------------------
// 3. PESANAN (ORDERS)
// -------------------------------------------------------------
enum OrderStatus {
  PENDING
  CONFIRMED
  COOKING
  COMPLETED
  CANCELLED
}

model Order {
  id            String      @id @default(uuid())
  orderCode     String      @unique @map("order_code")
  customerName  String      @map("customer_name")
  customerPhone String?     @map("customer_phone")
  orderType     String      @default("VOZA") @map("order_type")
  division      String
  location      String
  addressDetail String?     @map("address_detail") @db.Text
  mapUrl        String?     @map("map_url")
  latitude      Float?
  longitude     Float?
  targetDate    DateTime    @map("target_date") @db.Date
  notes         String?     @db.Text
  totalAmount   Int         @map("total_amount")
  status        OrderStatus @default(PENDING)
  paymentMethod String      @default("QRIS") @map("payment_method")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  items         OrderItem[]

  @@index([targetDate])
  @@index([createdAt])
  @@index([division])
  @@index([status])
  @@index([orderType])
  @@map("orders")
}

// -------------------------------------------------------------
// 4. RINCIAN ITEM PESANAN
// -------------------------------------------------------------
model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String?  @map("product_id")
  productName String   @map("product_name")
  unitPrice   Int      @map("unit_price")
  quantity    Int
  subtotal    Int

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productName])
  @@map("order_items")
}

// -------------------------------------------------------------
// 5. ADMIN USER
// -------------------------------------------------------------
model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}
